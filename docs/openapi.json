{
  "openapi": "3.1.0",
  "info": {
    "title": "Practice Sessions API",
    "description": "Manage communication practice sessions.",
    "version": "1.0.0"
  },
  "paths": {
    "/practices": {
      "get": {
        "tags": [
          "practices"
        ],
        "summary": "List Practices",
        "description": "List all practice sessions, newest first.",
        "operationId": "list_practices_practices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PracticeOut"
                  },
                  "type": "array",
                  "title": "Response List Practices Practices Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "practices"
        ],
        "summary": "Create Practice",
        "description": "Create a practice session.",
        "operationId": "create_practice_practices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PracticeCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/practices/{practice_id}": {
      "put": {
        "tags": [
          "practices"
        ],
        "summary": "Update Practice",
        "description": "Replace every editable field of an existing practice.",
        "operationId": "update_practice_practices__practice_id__put",
        "parameters": [
          {
            "name": "practice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Practice Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PracticeUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "practices"
        ],
        "summary": "Delete Practice",
        "description": "Delete a practice. Returns 204 with an empty body.",
        "operationId": "delete_practice_practices__practice_id__delete",
        "parameters": [
          {
            "name": "practice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Practice Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/practices/{practice_id}/complete": {
      "patch": {
        "tags": [
          "practices"
        ],
        "summary": "Complete Practice",
        "description": "Mark a practice as completed. Idempotent \u2014 calling it twice is harmless.",
        "operationId": "complete_practice_practices__practice_id__complete_patch",
        "parameters": [
          {
            "name": "practice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Practice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Quick check that the API is reachable which is handy from the phone's browser.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Difficulty": {
        "type": "string",
        "enum": [
          "Beginner",
          "Intermediate",
          "Advanced"
        ],
        "title": "Difficulty",
        "description": "How hard a practice session is. Inheriting from `str` means these\nserialise to plain strings like \"Beginner\" in JSON."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PracticeCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Duration Minutes",
            "description": "Duration in minutes"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty",
            "default": "Beginner"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "default": "Pending"
          }
        },
        "type": "object",
        "required": [
          "title",
          "duration_minutes"
        ],
        "title": "PracticeCreate",
        "description": "Body of POST /practices."
      },
      "PracticeOut": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Duration Minutes",
            "description": "Duration in minutes"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty",
            "default": "Beginner"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "default": "Pending"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "duration_minutes",
          "id",
          "created_at",
          "updated_at"
        ],
        "title": "PracticeOut",
        "description": "What the API sends back."
      },
      "PracticeUpdate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Duration Minutes",
            "description": "Duration in minutes"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty",
            "default": "Beginner"
          },
          "status": {
            "$ref": "#/components/schemas/Status",
            "default": "Pending"
          }
        },
        "type": "object",
        "required": [
          "title",
          "duration_minutes"
        ],
        "title": "PracticeUpdate",
        "description": "Body of PUT /practices/{id}."
      },
      "Status": {
        "type": "string",
        "enum": [
          "Pending",
          "Completed"
        ],
        "title": "Status",
        "description": "Whether the user has finished the practice yet."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
